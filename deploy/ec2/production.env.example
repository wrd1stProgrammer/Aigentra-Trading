APP_ENV=production
CORS_ORIGINS=https://aigentra-trading.nostalgia-drive.com

BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
ALLOW_REMOTE_DATABASE_IN_LOCAL=false
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=180
DATABASE_CONNECT_TIMEOUT_SECONDS=10

REDIS_URL=redis://redis:6379/0
REDIS_MARKET_CACHE_ENABLED=true
REDIS_KEY_PREFIX=aigentra
REDIS_SOCKET_TIMEOUT_SECONDS=1.5

SUBSCRIBER_API_TOKEN=
TELEGRAM_BOT_TOKEN=
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
WHOP_API_BASE_URL=https://api.whop.com/api/v1
WHOP_API_VERSION_DATE=
WHOP_PLAN_KEY=aigentra_pro_monthly
WHOP_PLAN_ID=
WHOP_PLAN_TITLE=Aigentra Pro
WHOP_PLAN_TYPE=renewal
WHOP_PLAN_CURRENCY=usd
WHOP_PLAN_INITIAL_PRICE=
WHOP_PLAN_RENEWAL_PRICE=
WHOP_PLAN_BILLING_PERIOD_DAYS=30
WHOP_CHECKOUT_TIMEOUT_SECONDS=10

AI_PROVIDER=gemini
AI_MISSING_KEY_FALLBACK_TO_MOCK=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TRANSLATION_ENABLED=true
OPENAI_TRANSLATION_MODEL=gpt-4.1-nano
AI_TRANSLATION_TARGET_LOCALES=ko,ru,pt-BR,tr
AI_TRANSLATION_TIMEOUT_SECONDS=30
AI_TRANSLATION_CONCURRENCY=4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GROK_API_KEY=
GROK_MODEL=grok-2-latest

PAPER_DEFAULT_EQUITY=10000
PAPER_MAKER_FEE_RATE=0.0002
PAPER_TAKER_FEE_RATE=0.0005
PAPER_SLIPPAGE_RATE=0.0001
PAPER_MAX_LEVERAGE=10
PAPER_MIN_MARGIN_DEPLOYMENT_PERCENT=20
PAPER_MAX_MARGIN_DEPLOYMENT_PERCENT=100
PAPER_MAX_ACTIVE_POSITIONS_PER_TRADER=1
EQUITY_SNAPSHOT_INTERVAL_SECONDS=300
EQUITY_SNAPSHOT_MIN_CHANGE_PERCENT=0.03

ENABLE_AUTO_SCANNER=true
AUTO_SCANNER_SYMBOLS=BTCUSDT
AUTO_SCANNER_INTERVAL_SECONDS=60
AUTO_SCANNER_PROVIDER=gemini
AUTO_SCANNER_LOCALE=en
AUTO_SCANNER_SNAPSHOT_CONCURRENCY=3
AUTO_SCANNER_AI_CONCURRENCY=2
AI_REJECTION_COOLDOWN_SECONDS=300

ENABLE_POSITION_MANAGEMENT_AI=true
POSITION_MANAGEMENT_PROVIDER=gemini
POSITION_MANAGEMENT_COOLDOWN_SECONDS=300
POSITION_MANAGEMENT_MAX_REVIEWS_PER_CYCLE=2
POSITION_MANAGEMENT_PENDING_HEARTBEAT_SECONDS=300
POSITION_MANAGEMENT_OPEN_HEARTBEAT_SECONDS=300
POSITION_MANAGEMENT_URGENT_COOLDOWN_SECONDS=60
LEAGUE_SENTIMENT_PROVIDER=
LEAGUE_SENTIMENT_RECENT_HOURS=24
PRICE_SHOCK_THRESHOLD_PERCENT=0.7
PRICE_SHOCK_REVIEW_SECONDS=120
PRICE_SHOCK_REVIEW_CYCLES=5
